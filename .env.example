# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=./models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=./models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/
# 用户上传文档的数据根目录
DATA_BASED_ROOT_DIR=./data-root/

# ====================
# MinerU（PDF 解析服务）
# ====================
# MinerU API Token（在 https://mineru.net 申请后填入）
MINERU_API_TOKEN=
# MinerU API 地址
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=qwen3-vl-flash

# 图片摘要开关：on=调 VL 模型给每张图生成描述 / off=跳过（图片仍上传，只保留 URL）
# 批量灌语料时设 off 可省下大量调用时间
MD_IMG_SUMMARY=on
# 图片摘要速率上限（次/分钟）。原来硬编码 10，一份上百张图的手册会卡在等待上
VL_RPM=60
# 商品名识别模型
ITEM_MODEL=qwen-flash

# ---- 大模型后端（按角色可选云端/本地）----
# dashscope=百炼云端（消耗额度） / local=本地 OpenAI 兼容端点（Ollama、vLLM、LM Studio 均可）
LLM_BACKEND=dashscope
# 各角色可单独覆盖：把 ITEM_BACKEND=local 就能做到"回答用云、商品名识别用本地"
# LLM_BACKEND= / ITEM_BACKEND= / VL_BACKEND=
# 本地端点（切到 local 时生效）
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_API_KEY=ollama
# 本地文本模型；8G 显存建议 3B 量化版，7B 需与 BGE-M3 抢显存
LLM_LOCAL_MODEL=qwen2.5:3b
# 本地多模态模型（图片描述用，可单独指定；不写则跟随 LLM_LOCAL_MODEL）
# VL_LOCAL_MODEL=qwen2.5vl:3b

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=./models/modelscope_cache/models/BAAI/bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）
BGE_FP16=True
# ====================
# 重排后端（Reranker）
# ====================
# 后端选择：dashscope=云端 qwen3-rerank（消耗额度） / local=本地 bge-reranker（不消耗额度）
RERANK_BACKEND=dashscope

# --- 本地后端配置（RERANK_BACKEND=local 时生效）---
# 模型目录。推荐 BAAI/bge-reranker-v2-m3（多语言，中文效果优于 bge-reranker-large）
# 下载：modelscope download --model BAAI/bge-reranker-v2-m3 --local-dir ./models/bge-reranker-v2-m3
BGE_RERANKER_PATH=./models/bge-reranker-v2-m3
# 旧变量名，保留兼容；新配置请用 BGE_RERANKER_PATH
BGE_RERANKER_LARGE=./models/bge-reranker-v2-m3
# 运行设备
BGE_RERANKER_DEVICE=cuda:0
# 是否半精度（GTX 10 系为 Pascal 架构，FP16 吞吐很差，建议 0）
BGE_RERANKER_FP16=0
# 单条文本截断长度 / 推理批大小
BGE_RERANKER_MAX_LENGTH=512
BGE_RERANKER_BATCH=8

# --- 云端后端配置（RERANK_BACKEND=dashscope 时生效）---
# 模型名与指令，实际取值见文件末尾的 Text Rerank 段

# --- 重排后动态截断（断崖检测）参数 ---
# 换后端后分数分布会变，这几个值的松紧需要重新观察
RERANK_MAX_TOPK=5
RERANK_MIN_TOPK=2
RERANK_GAP_ABS=0.3
RERANK_GAP_RATIO=0.25
# 相对分差生效的最低分数：低于此分不再用相对分差判崖，避免尾部噪声触发截断
RERANK_RATIO_MIN_SCORE=0.1
# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://localhost:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://localhost:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=localhost:9000
# 访问密钥（以下为 MinIO 默认演示账号，生产环境请务必修改）
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=images

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ====================
# Text Rerank
# ====================
TEXT_RERANK_MODEL=qwen3.7-text-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落