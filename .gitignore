# ============ 评测产物（可随时重新生成，不入库）============
eval/.cache/
eval/results/
# 标注集里的 chunk_id 是本机 Milvus 的自增主键，换台机器就失效，故默认不入库；
# 但当前主标注集需要随仓库分发（README 的评测结论依赖它，且可用 remap 重新锚定），
# 因此白名单放行；换机器后执行 scripts/remap_gold.py 重新绑定 chunk_id 即可。
# 历史备份（pre_expand / pre_remap / *.bak_*）保持忽略。
eval/datasets/*.jsonl
eval/datasets/*.csv
!eval/datasets/qa_template.jsonl
!eval/datasets/qa_hard.jsonl
# 注意：qa_hard_extra*.jsonl 是 scripts/gen_cover_all.py 的**中间产物**，
# 由 scripts/merge_gold.py 合进 qa_hard.jsonl 之后就作废了，不要再放行。
# 之前把 extra2 放行入库，结果仓库里同时存在两份 164 题、内容逐条相同的标注集
# （除 qid 前缀 gen/cov 不同），看起来像 328 题，实际全是重复。

# ============ Docker Compose 数据卷（一键启动中间件时生成）============
volumes/

# ============ 备份文件 ============
*.bak
*.bak-*
*.bak_*
*~
