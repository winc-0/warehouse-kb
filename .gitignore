# ============ 密钥与环境变量（绝对不能提交！）============
.env
.env.local
.env.*.local
*.key
*.pem
secrets.json

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/
build/
dist/

